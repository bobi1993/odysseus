# face-service/.env.example
# Copy to .env and adjust paths for your host

# Model config
FACE_MODEL_NAME=w600k_r50
FACE_MODEL_DIR=/app/models
FACE_DETECTION_CTX_ID=0
FACE_DETECTION_SIZE=640

# Similarity thresholds
FACE_MATCH_THRESHOLD=0.35
FACE_CLUSTER_THRESHOLD=0.50
FACE_MIN_CONFIDENCE=0.60

# Keyframe extraction
KEYFRAME_INTERVAL_SEC=5
KEYFRAME_MAX_PER_VIDEO=20
KEYFRAME_MIN_DIMENSION=256

# Ollama fallback (optional)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=llava:latest

# Keys
API_KEY=

# Logging
LOG_LEVEL=INFO
